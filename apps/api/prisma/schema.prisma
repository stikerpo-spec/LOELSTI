generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Presence { ONLINE IDLE DND INVISIBLE OFFLINE }
enum ChannelType { TEXT VOICE VIDEO FORUM ANNOUNCEMENT STAGE TICKET }
enum MessageStatus { SENT DELETED }
enum ConversationType { DM GROUP }
enum ThreadStatus { OPEN ARCHIVED LOCKED }
enum Permission { VIEW_SERVER MANAGE_SERVER MANAGE_CHANNELS MANAGE_ROLES MANAGE_MEMBERS MANAGE_INVITES VIEW_AUDIT SEND_MESSAGES MANAGE_MESSAGES ATTACH_FILES EMBED_LINKS ADD_REACTIONS CONNECT SPEAK VIDEO STREAM MUTE_MEMBERS DEAFEN_MEMBERS MOVE_MEMBERS MENTION_EVERYONE CREATE_THREADS MANAGE_THREADS }
model User {
  id String @id @default(cuid()); username String @unique; displayName String; email String @unique; passwordHash String
  avatarUrl String?; bannerUrl String?; bio String?; presence Presence @default(OFFLINE); customStatus String?
  createdAt DateTime @default(now()); updatedAt DateTime @updatedAt
  sessions Session[]; memberships ServerMember[]; ownedServers Server[] @relation("serverOwner"); messages Message[]; reactions MessageReaction[]
  sentFriendRequests FriendRequest[] @relation("sent"); receivedFriendRequests FriendRequest[] @relation("received")
  friendshipsA Friendship[] @relation("a"); friendshipsB Friendship[] @relation("b"); blocksFrom Block[] @relation("from"); blocksTo Block[] @relation("to")
  conversationMemberships ConversationMember[]; createdConversations Conversation[] @relation("conversationCreator"); notifications Notification[]; readStates ReadState[]
  moderationActions ModerationCase[] @relation("moderator"); threadMemberships ThreadMember[]
}
model Session { id String @id @default(cuid()); userId String; tokenHash String @unique; expiresAt DateTime; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId]) }
model FriendRequest { id String @id @default(cuid()); senderId String; receiverId String; createdAt DateTime @default(now()); sender User @relation("sent",fields:[senderId],references:[id],onDelete:Cascade); receiver User @relation("received",fields:[receiverId],references:[id],onDelete:Cascade); @@unique([senderId,receiverId]); @@index([receiverId,createdAt]) }
model Friendship { id String @id @default(cuid()); userAId String; userBId String; createdAt DateTime @default(now()); userA User @relation("a",fields:[userAId],references:[id],onDelete:Cascade); userB User @relation("b",fields:[userBId],references:[id],onDelete:Cascade); @@unique([userAId,userBId]) }
model Block { id String @id @default(cuid()); fromUserId String; toUserId String; createdAt DateTime @default(now()); fromUser User @relation("from",fields:[fromUserId],references:[id],onDelete:Cascade); toUser User @relation("to",fields:[toUserId],references:[id],onDelete:Cascade); @@unique([fromUserId,toUserId]); @@index([toUserId]) }
model Server { id String @id @default(cuid()); name String; iconUrl String?; bannerUrl String?; description String?; ownerId String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; members ServerMember[]; roles Role[]; channels Channel[]; categories Category[]; invites Invite[]; owner User @relation("serverOwner",fields:[ownerId],references:[id]); @@index([ownerId]) }
model ServerMember { id String @id @default(cuid()); serverId String; userId String; nickname String?; joinedAt DateTime @default(now()); server Server @relation(fields:[serverId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); roles MemberRole[]; @@unique([serverId,userId]); @@index([userId]) }
model Role { id String @id @default(cuid()); serverId String; name String; color String?; position Int @default(0); mentionable Boolean @default(false); server Server @relation(fields:[serverId],references:[id],onDelete:Cascade); permissions RolePermission[]; members MemberRole[]; @@index([serverId,position]) }
model RolePermission { id String @id @default(cuid()); roleId String; permission Permission; role Role @relation(fields:[roleId],references:[id],onDelete:Cascade); @@unique([roleId,permission]) }
model MemberRole { id String @id @default(cuid()); memberId String; roleId String; member ServerMember @relation(fields:[memberId],references:[id],onDelete:Cascade); role Role @relation(fields:[roleId],references:[id],onDelete:Cascade); @@unique([memberId,roleId]) }
model Category { id String @id @default(cuid()); serverId String; name String; position Int @default(0); server Server @relation(fields:[serverId],references:[id],onDelete:Cascade); channels Channel[]; @@index([serverId,position]) }
model Channel { id String @id @default(cuid()); serverId String; categoryId String?; name String; topic String?; type ChannelType @default(TEXT); position Int @default(0); slowmodeSeconds Int @default(0); server Server @relation(fields:[serverId],references:[id],onDelete:Cascade); category Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull); messages Message[]; threads Thread[]; @@index([serverId,position]); @@index([categoryId,position]) }
model Message { id String @id @default(cuid()); channelId String?; conversationId String?; authorId String; content String; status MessageStatus @default(SENT); replyToId String?; clientMessageId String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt
  channel Channel? @relation(fields:[channelId],references:[id],onDelete:Cascade); conversation Conversation? @relation(fields:[conversationId],references:[id],onDelete:Cascade); author User @relation(fields:[authorId],references:[id]); replyTo Message? @relation("replies",fields:[replyToId],references:[id]); replies Message[] @relation("replies"); reactions MessageReaction[]; threadsStarted Thread[] @relation("threadStarter")
  @@index([channelId,createdAt,id]); @@index([conversationId,createdAt,id]); @@index([authorId,createdAt]); @@unique([authorId,clientMessageId]) }
model MessageReaction { id String @id @default(cuid()); messageId String; userId String; emoji String; createdAt DateTime @default(now()); message Message @relation(fields:[messageId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@unique([messageId,userId,emoji]) }
model Invite { id String @id @default(cuid()); serverId String; code String @unique; maxUses Int?; uses Int @default(0); expiresAt DateTime?; createdAt DateTime @default(now()); server Server @relation(fields:[serverId],references:[id],onDelete:Cascade) }
model Conversation { id String @id @default(cuid()); type ConversationType @default(DM); name String?; avatarUrl String?; createdById String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; createdBy User @relation("conversationCreator",fields:[createdById],references:[id]); members ConversationMember[]; messages Message[]; @@index([createdById]) }
model ConversationMember { id String @id @default(cuid()); conversationId String; userId String; joinedAt DateTime @default(now()); conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@unique([conversationId,userId]); @@index([userId]) }
model ReadState { id String @id @default(cuid()); userId String; channelId String?; conversationId String?; lastReadMessageId String?; mentionCount Int @default(0); updatedAt DateTime @updatedAt; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,channelId]); @@index([userId,conversationId]) }
model Thread { id String @id @default(cuid()); channelId String; starterMessageId String; name String; status ThreadStatus @default(OPEN); archivedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; channel Channel @relation(fields:[channelId],references:[id],onDelete:Cascade); starterMessage Message @relation("threadStarter",fields:[starterMessageId],references:[id],onDelete:Cascade); members ThreadMember[]; @@index([channelId,status,updatedAt]) }
model ThreadMember { id String @id @default(cuid()); threadId String; userId String; joinedAt DateTime @default(now()); thread Thread @relation(fields:[threadId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@unique([threadId,userId]) }
model Notification { id String @id @default(cuid()); userId String; type String; title String; body String; data Json?; readAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,readAt,createdAt]) }
model ModerationCase { id String @id @default(cuid()); serverId String; targetUserId String; moderatorId String; action String; reason String?; durationSeconds Int?; createdAt DateTime @default(now()); server Server @relation(fields:[serverId],references:[id],onDelete:Cascade); targetUser User @relation(fields:[targetUserId],references:[id],onDelete:Cascade); moderator User @relation("moderator",fields:[moderatorId],references:[id]); @@index([serverId,createdAt]); @@index([targetUserId,createdAt]) }
