{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOELSTI",
  "version": "0.2.0",
  "identifier": "de.loelsti.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LOELSTI",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "category": "SocialNetworking",
    "shortDescription": "Eigenständige Echtzeit-Kommunikationsplattform",
    "longDescription": "LOELSTI ist eine eigenständige Kommunikations- und Community-Plattform als Desktop-Anwendung.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["German", "English"]
      }
    }
  }
}
